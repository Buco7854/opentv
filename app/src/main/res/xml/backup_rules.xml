<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- allowBackup=false disables pre-31 backup. These matching exclusions
         make the sensitive-store policy explicit and provide defense in depth. -->
    <exclude domain="database" path="opentv.db" />
    <exclude domain="database" path="opentv.db-journal" />
    <exclude domain="database" path="opentv.db-shm" />
    <exclude domain="database" path="opentv.db-wal" />
    <exclude domain="sharedpref" path="hub_sessions.xml" />
    <exclude domain="file" path="datastore/player_prefs.preferences_pb" />
</full-backup-content>
